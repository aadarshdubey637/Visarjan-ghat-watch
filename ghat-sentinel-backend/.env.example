APP_NAME=Ghat Sentinel
APP_ENV=development
API_PREFIX=/api/v1

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000
# SQLite for local development. For PostgreSQL (e.g. Neon) paste the connection string from the provider's
# dashboard, for example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# (postgres:// and postgresql:// are converted to the psycopg 3 driver automatically).
DATABASE_URL=sqlite:///./ghat_sentinel.db
# Optional regex for extra allowed origins, e.g. Vercel previews: https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
DATA_DIR=./data

# AI wording uses the Claude API. Leave empty to run deterministic-only (template briefs, no AI wording).
# ANTHROPIC_MODEL must be a model ID enabled for your key, e.g. a Haiku model (cheap/fast) or a Sonnet model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_TIMEOUT_SECONDS=20

AI_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO

# Authentication (see docs/AUTH.md). JWT_SECRET is required when APP_ENV=production.
AUTH_ENABLED=true
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
# Demo accounts exist only when DEMO_USERS=true AND APP_ENV=development
DEMO_USERS=true
BOOTSTRAP_OFFICER_EMAIL=
BOOTSTRAP_OFFICER_PASSWORD=
# Optional presenter (demo role) account, created in any environment if both are set.
# It has officer rights (it can create cases, briefs and reports) but no user management.
PRESENTER_EMAIL=
PRESENTER_PASSWORD=
# true = create the six sample review cases even outside development (pitch deployments). The sample worker
# account then gets a random password nobody knows.
SEED_DEMO_CASES=false

# Messaging (see docs/MESSAGING.md). Placeholders only: put real values in your private .env, never commit them.
# E-mail via SMTP (Gmail: smtp.gmail.com, 587, STARTTLS, username = gmail address, password = 16-char App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. Ghat Sentinel <you@example.com>; falls back to SMTP_USERNAME
SMTP_FROM=
SMTP_STARTTLS=true
# true for implicit TLS on port 465 (then STARTTLS is ignored)
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
# WhatsApp Cloud API (Meta). Use a permanent System User token; the temporary one expires in 24 hours.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# template (approved template, works any time) or text (only inside the 24-hour customer-service window)
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TIMEOUT_SECONDS=15
# true = log messages as dry_run and never call SMTP/Meta (no configuration needed)
MESSAGING_DRY_RUN=false
MESSAGING_MAX_RECIPIENTS=20
MESSAGING_MAX_PER_HOUR=60
