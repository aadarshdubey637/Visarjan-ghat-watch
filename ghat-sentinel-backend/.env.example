APP_NAME=Ghat Sentinel
APP_ENV=development
API_PREFIX=/api/v1

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./ghat_sentinel.db
DATA_DIR=./data

# Leave empty to run deterministic-only (template briefs, no AI wording).
# Set CEREBRAS_MODEL to a model ID enabled for YOUR account (see the Cerebras dashboard).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TIMEOUT_SECONDS=20

AI_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
